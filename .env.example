# Copy to .env and fill in real values.

KAGGLE_API_TOKEN=your_kaggle_api_token

# ClickHouse connection used by the loader (and later dbt). Inside Docker the host is "clickhouse".
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# ClickHouse user created by the container on startup
CLICKHOUSE_USER=retail
CLICKHOUSE_PASSWORD=change_me
