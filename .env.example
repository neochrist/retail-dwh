# Copy to .env and fill in real values.

KAGGLE_API_TOKEN=your_kaggle_api_token

# ClickHouse connection for running the loader from the host. Inside Docker, compose sets the host to "clickhouse".
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# ClickHouse user created by the container on startup
CLICKHOUSE_USER=retail
CLICKHOUSE_PASSWORD=change_me

# Postgres: Airflow metadata only (never business data)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

# Airflow web UI login, created by airflow-init
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Linux only: set to the output of `id -u` so files Airflow writes are owned by you
AIRFLOW_UID=50000
